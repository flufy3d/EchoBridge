# EchoBridge runtime configuration (example).
# Copy to /etc/echobridge/echobridge.env, chmod 600, and set a real token.
# Never commit the filled-in file.

ECHOBRIDGE_DEV=0
ECHOBRIDGE_TOKEN=replace-with-a-long-random-token
ECHOBRIDGE_BIND=127.0.0.1
ECHOBRIDGE_PORT=18787

# Phase 2 VAD / ASR
ECHOBRIDGE_VAD_BACKEND=silero
ECHOBRIDGE_SILERO_THRESHOLD=0.5
ECHOBRIDGE_VAD_ENDPOINT_MS=500
# Idle pre-roll; covers a soft leading clause + comma pause (was 300).
ECHOBRIDGE_VAD_PRE_ROLL_MS=800
# Pre-roll while a response plays (AEC residual echo).
ECHOBRIDGE_VAD_PLAYBACK_PRE_ROLL_MS=300
# Idle-only threshold for opening a segment; 1 dip window tolerated.
ECHOBRIDGE_SILERO_START_THRESHOLD=0.35
ECHOBRIDGE_VAD_START_GAP_WINDOWS=1
# Short (<min_speech) segment is prepended to a segment starting within this.
ECHOBRIDGE_VAD_SHORT_CARRY_MS=1000
# Debug: dump each ASR input segment (wav+txt). Leave empty in normal use.
ECHOBRIDGE_VAD_DUMP_DIR=
# Debug: once-per-second mic level / max Silero probability log.
ECHOBRIDGE_VAD_TRACE=0
ECHOBRIDGE_VAD_TAIL_PAD_MS=100
ECHOBRIDGE_VAD_SPECULATIVE_LEAD_MS=150
# ASR backends:
#   inprocess  Qwen3-ASR inside the gateway (default; ~900 ms after endpoint)
#   vllm       Qwen3-ASR served by vLLM 0.32 on :18801 (CUDA graphs;
#              ~120 ms after endpoint on a 3070, ~2.3 GiB VRAM; the gateway
#              itself then needs no GPU)
#   qwen3      legacy 18801 worker (scripts/asr_worker.sh)
ECHOBRIDGE_ASR_BACKEND=inprocess
ECHOBRIDGE_ASR_MODEL=~/.cache/echobridge/models/Qwen3-ASR-0.6B
ECHOBRIDGE_ASR_DEVICE=cuda:0
ECHOBRIDGE_ASR_ATTN_IMPLEMENTATION=sdpa
ECHOBRIDGE_ASR_URL=http://127.0.0.1:18801
ECHOBRIDGE_ASR_TIMEOUT_S=8
ECHOBRIDGE_ASR_LANGUAGE=Chinese
ECHOBRIDGE_ASR_MAX_NEW_TOKENS=192
# Used by ECHOBRIDGE_ASR_BACKEND=vllm (scripts/asr_vllm.sh).
ECHOBRIDGE_ASR_VLLM_MODEL=qwen3-asr
# The KV cache is sized explicitly (256 MiB = 2,336 tokens); vLLM's own
# profiling is unreliable on WSL2.  GPU_UTIL then only gates vLLM's startup
# check.  MIN_FREE_MB is the nvidia-smi headroom required before starting.
ECHOBRIDGE_ASR_KV_CACHE_BYTES=268435456
ECHOBRIDGE_ASR_GPU_UTIL=0.30
ECHOBRIDGE_ASR_MIN_FREE_MB=2600
ECHOBRIDGE_ASR_MAX_MODEL_LEN=512
ECHOBRIDGE_ASR_MAX_NUM_SEQS=1
# Qwen3-ASR contextual biasing (optional, pipe-separated).  Not a weighted
# hotword table: it is injected as the ASR context prompt.  Keep it short.
ECHOBRIDGE_ASR_HOTWORDS=ChatGPT|Claude|溟月|小鲸鱼|大肥鱼

# Phase 3 TTS
ECHOBRIDGE_TTS_BACKEND=vllm
ECHOBRIDGE_TTS_URL=http://127.0.0.1:18802
ECHOBRIDGE_TTS_TIMEOUT_S=30
# After a TTS worker restart, force one real synthesis on the down->up edge.
# 0 disables the watcher.
ECHOBRIDGE_TTS_RECOVERY_PROBE_S=10
ECHOBRIDGE_TTS_VOICE_ID=mingyue_v1
# Multi-voice registry.  Leave the registry path empty to use
# <voice_dir>/voices.json.  See docs/VOICES.md.
ECHOBRIDGE_TTS_VOICE_DIR=~/.cache/echobridge/voices/mingyue
ECHOBRIDGE_TTS_VOICE_REGISTRY=
ECHOBRIDGE_TTS_REF_AUDIO=~/.cache/echobridge/voices/mingyue/reference.wav
ECHOBRIDGE_TTS_REF_TEXT=~/.cache/echobridge/voices/mingyue/reference.txt
# vLLM-Omni GPU share; lower this first if the desktop/other GPU work OOMs.
# Single-session slim profile: stage 0 0.30 + stage 1 0.18, ~4.4 GiB total.
ECHOBRIDGE_TTS_GPU_UTIL=0.30
# Experimental all-in-one HF TTS (not default: pure-PyTorch RTF ~4 on a 3070).
# ECHOBRIDGE_TTS_BACKEND=inprocess
# ECHOBRIDGE_TTS_MODEL=~/.cache/echobridge/models/Qwen3-TTS-12Hz-0.6B-Base
# ECHOBRIDGE_TTS_INITIAL_CODEC_FRAMES=1
# ECHOBRIDGE_TTS_CODEC_CHUNK_FRAMES=25
# Ramp packet durations instead of a flat 1 -> 25 frame step.  The in-process
# backend defaults to 2/4/8/12/25 codec frames (vLLM uses the deploy yaml).
# ECHOBRIDGE_TTS_CODEC_CHUNK_RAMP=2,4,8,12,25
# ECHOBRIDGE_TTS_CODEC_LEFT_CONTEXT_FRAMES=72
# ECHOBRIDGE_TTS_COMPILE=0

# Phase 5 natural backchannel (cached at TTS warmup; does not delay formal TTS)
ECHOBRIDGE_BACKCHANNEL_ENABLED=1
ECHOBRIDGE_BACKCHANNEL_DELAY_MS=1500
ECHOBRIDGE_BACKCHANNEL_PHRASES=嗯…让我想想|我想想～|这个嘛～|我看看哦～
# Optional hand-picked clips: <dir>/<voice_id>/clips.json {"phrase": "file.wav"}
# Empty = <ECHOBRIDGE_TTS_VOICE_DIR>/backchannel
ECHOBRIDGE_BACKCHANNEL_CLIP_DIR=

# Phase 4 DeepSeek
ECHOBRIDGE_LLM_BACKEND=deepseek
ECHOBRIDGE_LLM_URL=https://opencode.ai/inference/openai/v1/chat/completions
ECHOBRIDGE_LLM_MODEL=deepseek-v4.1-flash
ECHOBRIDGE_LLM_API_KEY=replace-with-key
ECHOBRIDGE_LLM_MAX_TOKENS=400
ECHOBRIDGE_LLM_TEMPERATURE=0.6
ECHOBRIDGE_LLM_FIRST_TOKEN_TIMEOUT_S=8
ECHOBRIDGE_LLM_TOTAL_TIMEOUT_S=30
# Real-time voice replies do not need reasoning; `enabled` adds 200-400 ms.
ECHOBRIDGE_LLM_THINKING=disabled
# Keep the TLS/HTTP connection alive between turns and warm it on VAD start.
ECHOBRIDGE_LLM_KEEPALIVE_S=300
ECHOBRIDGE_LLM_PREWARM=1
# Start the LLM from the speculative ASR result, before endpoint confirmation.
ECHOBRIDGE_LLM_SPECULATIVE=1

# Phase 1 mock fallback (only used when vad=energy/asr=mock)
ECHOBRIDGE_MOCK_ASR_TEXT=你好呀，溟月
ECHOBRIDGE_LLM_CHAR_DELAY_MS=12
ECHOBRIDGE_TTS_FIRST_CHUNK_MS=60
ECHOBRIDGE_TTS_TONE_CHAR_MS=55
ECHOBRIDGE_ENABLE_PROBE=0
ECHOBRIDGE_LOG_LEVEL=INFO

# Watchdog only (deploy/watchdog.sh); cold-start grace for Type=simple workers.
ECHOBRIDGE_WATCHDOG_GRACE_S=300
