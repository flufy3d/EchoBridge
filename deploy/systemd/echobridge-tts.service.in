[Unit]
Description=EchoBridge TTS worker (Qwen3-TTS via vLLM-Omni)
Documentation=file://@ROOT@/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target
# Do not give up after a handful of quick failures: a WSL2 CUDA context
# failure can require several cold starts before a fresh process sticks.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
Environment=HOME=@HOME@
Environment=PYTHONPATH=@ROOT@/src
EnvironmentFile=@ENV_FILE@
ExecStart=/bin/bash @ROOT@/scripts/tts_vllm.sh
# Stay "activating" until /health answers, so units ordered After= this one
# (the vLLM ASR worker) wait for a ready TTS instead of a forked process.
ExecStartPost=/bin/bash @ROOT@/deploy/worker-ready.sh tts
Restart=always
# Start the replacement as soon as the old cgroup is gone.  The model load
# (~2 min) dominates recovery; this only removes avoidable systemd delay.
RestartSec=2
# Two-stage model load plus CUDA graph capture takes ~2 min on a 3070.
TimeoutStartSec=600
TimeoutStopSec=20
KillMode=control-group
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=@WANTED_BY@
